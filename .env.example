# ========================================================
# 🌴 PARADISE PREMIUM RENTALS - VARIABLES DE ENTORNO
# ========================================================
# INSTRUCCIONES:
# Reemplaza los textos que dicen "pega-aqui-tu-..." por tus verdaderas claves.
# NO le pongas comillas a las claves.

# --------------------------------------------------------
# 1. SUPABASE (Base de Datos, Autenticación y Storage)
# --------------------------------------------------------
# Dónde encontrarlo: 
# Ve a Supabase Dashboard -> Project Settings (⚙️) -> API
VITE_SUPABASE_URL=pega-aqui-tu-project-url
VITE_SUPABASE_ANON_KEY=pega-aqui-tu-anon-public-key

# --------------------------------------------------------
# 2. DEEPSEEK (Inteligencia Artificial y Staging Virtual)
# --------------------------------------------------------
# Dónde encontrarlo:
# Ve a DeepSeek Platform (platform.deepseek.com) -> API Keys
VITE_DEEPSEEK_API_KEY=pega-aqui-tu-api-key-de-deepseek

# --------------------------------------------------------
# 3. CLOUDFLARE R2 (Almacenamiento de Imágenes)
# --------------------------------------------------------
VITE_R2_ACCOUNT_ID=pega-aqui-tu-r2-account-id
VITE_R2_ACCESS_KEY_ID=pega-aqui-tu-r2-access-key-id
VITE_R2_SECRET_ACCESS_KEY=pega-aqui-tu-r2-secret-access-key
VITE_R2_BUCKET_NAME=pega-aqui-tu-r2-bucket-name
VITE_R2_PUBLIC_DOMAIN=pega-aqui-tu-dominio-publico-de-r2

